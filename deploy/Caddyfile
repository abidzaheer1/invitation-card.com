{
	# A certificate is issued per invitation address, only after the API confirms the name.
	on_demand_tls {
		ask http://api:4000/api/internal/tls-ask
		interval 2m
		burst 5
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API requests go straight to the NestJS container.
	handle /api/* {
		reverse_proxy api:4000
	}

	# Everything else is the Next.js app. Long-lived caching for hashed assets.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# One hosted webpage per invitation: sara-omar.invitation-card.com
*.{$DOMAIN} {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000
	}
}
