# Copy to /opt/invitation-card/.env on the server and fill in real values.
DOMAIN=invitation-card.com
# Lowercase GitHub owner + repo prefix used by the CI workflow when pushing images.
IMAGE_PREFIX=ghcr.io/abidzaheer1/invitation-card
IMAGE_TAG=latest
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me
# Optional: Google sign-in. Create an OAuth 2.0 Web client at console.cloud.google.com,
# add https://YOUR_DOMAIN as an authorised JavaScript origin, and paste its client id here.
# Leave empty to offer email sign-in only.
GOOGLE_CLIENT_ID=

# Email (password reset, email confirmation). Use any SMTP service: Brevo, Resend, Amazon SES,
# or your Hostinger mailbox. A mailbox on a free plan that has no SMTP access will not work.
# Leave SMTP_HOST empty to switch email features off (people then sign in with Google or password only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender, for example: Invitation-card.com <no-reply@invitation-card.com>
MAIL_FROM=
# Publishing needs a confirmed email address. On by default whenever SMTP_HOST is set; set to 0 to turn it off.
REQUIRE_VERIFIED_EMAIL=
