PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://invitation:invitation@localhost:5432/invitation
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
# Where uploaded photos and 3D models are stored (defaults to ./uploads)
UPLOADS_DIR=./uploads
# Public address of the web app, used in links inside emails
SITE_URL=http://localhost:3000
# Email. Without SMTP_HOST, emails are printed in this terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Invitation-card.com <no-reply@localhost>"
# Access tokens last this long; the refresh cookie renews them quietly (default 15m)
# ACCESS_TOKEN_TTL=15m
