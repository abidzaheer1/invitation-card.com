# Copy to /opt/invitation-card/.env on the server and fill in real values.
DOMAIN=invitation-card.com
# Lowercase GitHub owner + repo prefix used by the CI workflow when pushing images.
IMAGE_PREFIX=ghcr.io/abidzaheer1/invitation-card
IMAGE_TAG=latest
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me
