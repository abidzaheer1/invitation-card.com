generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  WEDDING
  ENGAGEMENT
  BIRTHDAY
  BABY_SHOWER
  ANNIVERSARY
  GRADUATION
  CORPORATE
  OTHER
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum RsvpStatus {
  ATTENDING
  DECLINED
  MAYBE
}

model User {
  id            String       @id @default(cuid())
  email         String?      @unique
  passwordHash  String?
  googleId      String?      @unique
  // True once the address is confirmed by Google. Password sign-ups are not verified yet.
  emailVerified Boolean      @default(false)
  name          String?
  isGuest       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  // Consecutive wrong passwords. After too many the account is locked for a short while.
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  invitations   Invitation[]
  uploads       Upload[]
  sessions      Session[]
  emailTokens   EmailToken[]
}

// One signed-in browser. The refresh token itself is never stored, only its SHA-256 hash.
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  // All sessions descended from one sign-in. Reusing a rotated token revokes the whole family.
  familyId    String
  expiresAt   DateTime
  // Set when the token was swapped for a newer one.
  rotatedAt   DateTime?
  // Set on sign-out, password change or token theft. A revoked session never works again.
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ip          String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// Single-use links sent by email. Only the hash of the token is stored.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

// Emails waiting to be sent. Writing here first means a mail outage never loses a message.
model EmailOutbox {
  id        String    @id @default(cuid())
  toEmail   String
  subject   String
  text      String
  html      String
  attempts  Int       @default(0)
  sentAt    DateTime?
  lastError String?
  runAfter  DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([sentAt, runAfter])
}

model Invitation {
  id         String         @id @default(cuid())
  slug       String         @unique
  ownerId    String
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  eventType  EventType
  // InvitationContent from @invitation/shared
  content    Json
  // RsvpField[] from @invitation/shared
  rsvpFields Json
  published  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  responses  RsvpResponse[]

  @@index([ownerId])
}

model RsvpResponse {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  status       RsvpStatus
  guestName    String
  answers      Json
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // "image" or "model"
  kind      String
  filename  String   @unique
  bytes     Int
  createdAt DateTime @default(now())

  @@index([ownerId])
}
